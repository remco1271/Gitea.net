<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Gitea.Net.Test</AssemblyName>
    <RootNamespace>Gitea.Net.Test</RootNamespace>
    <TargetFramework>net8.0</TargetFramework>
    <!-- xunit.v3 test projects are executables that run on Microsoft.Testing.Platform (see global.json) -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <Nullable>annotations</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gitea.Net\Gitea.Net.csproj" />
  </ItemGroup>
</Project>
